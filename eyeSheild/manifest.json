{
  "manifest_version": 3,
  "name": "HumanSignal Prototype",
  "version": "0.2.0",
  "description": "Flag or hide YouTube videos using your own keyword filters.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],

  "action": {
    "default_popup": "popup.html",
    "default_title": "HumanSignal"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["img/*"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}